# TechNova E-Commerce Environment Configuration

# ── Supabase / PostgreSQL Database Connection ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Direct PostgreSQL Connection String (Optional) ─────────
POSTGRES_URL=postgresql://postgres.your-project-id:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Email Service Credentials (Optional) ───────────────────
RESEND_API_KEY=re_123456789
EMAIL_FROM=noreply@technova.de

# ── Demo Accounts (for development/testing only) ───────────
# These credentials are used by the login API when Supabase is not configured.
# DO NOT use these in production.
DEMO_ADMIN_EMAIL=admin@technova.store
DEMO_ADMIN_PASSWORD=your-secure-admin-password
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=your-secure-customer-password

# ── Cookie Signing Secret (REQUIRED) ───────────────────────
# Used to HMAC-sign auth cookies to prevent forgery.
# Generate with: openssl rand -hex 32
AUTH_COOKIE_SECRET=change-this-to-a-random-secret-in-production
