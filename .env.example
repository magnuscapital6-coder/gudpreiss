# GudPreiss E-Commerce Environment Configuration

# ── Supabase / PostgreSQL Database Connection ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Direct PostgreSQL Connection String (Optional) ─────────
POSTGRES_URL=postgresql://postgres.your-project-id:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── Email Service Configuration (SMTP & API) ────────────────
# 1. SMTP Server Settings (Standard / Recommended for production)
SMTP_HOST=smtp.your-mail-provider.com
SMTP_PORT=587
SMTP_USER=kontakt@gudpreiss.de
SMTP_PASSWORD=your-smtp-secure-password
SMTP_ENCRYPTION=tls
# SMTP_SECURE=false # Set to true if using port 465 (SSL), false for 587 (TLS/STARTTLS)

# 2. Sender Details
MAIL_FROM=kontakt@gudpreiss.de
MAIL_FROM_NAME="GudPreiss Deutschland"
EMAIL_FROM="GudPreiss <kontakt@gudpreiss.de>"

# 3. Admin Notification Recipient(s)
ADMIN_EMAIL=admin@gudpreiss.store
SUPPORT_EMAIL=kontakt@gudpreiss.de
ADMIN_NOTIFICATION_EMAIL=admin@gudpreiss.store

# 4. Resend API (Alternative or fallback transport)
RESEND_API_KEY=re_123456789

# ── Demo Accounts (for development/testing only) ───────────
DEMO_ADMIN_EMAIL=admin@gudpreiss.store
DEMO_ADMIN_PASSWORD=your-secure-admin-password
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=your-secure-customer-password

# ── Cookie Signing Secret (REQUIRED in production) ─────────
AUTH_COOKIE_SECRET=change-this-to-a-random-secret-in-production

# ── Cron Secret (REQUIRED for cron endpoints) ───────────────
CRON_SECRET=change-this-to-a-random-secret-in-production
